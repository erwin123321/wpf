<Window x:Class="GeneratorHasel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy pracownik, wykonał: 123456"
        Height="450"
        Width="800"
        Background="#E0F2F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <GroupBox Header="Dane pracownika"
                  Grid.Row="0"
                  Grid.Column="0"
                  Margin="5">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Label Content="Imię:"
                       Grid.Row="0"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="txtImie"
                         Grid.Row="0"
                         Margin="100,5,5,5"/>

                <Label Content="Nazwisko:"
                       Grid.Row="1"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="txtNazwisko"
                         Grid.Row="1"
                         Margin="100,5,5,5"/>

                <Label Content="Stanowisko:"
                       Grid.Row="2"
                       VerticalAlignment="Center"/>

                <ComboBox x:Name="cmbStanowisko"
                          Grid.Row="2"
                          Margin="100,5,5,5"
                          SelectedIndex="0">

                    <ComboBoxItem>Kierownik</ComboBoxItem>
                    <ComboBoxItem>Starszy programista</ComboBoxItem>
                    <ComboBoxItem>Młodszy programista</ComboBoxItem>
                    <ComboBoxItem>Tester</ComboBoxItem>

                </ComboBox>
            </Grid>
        </GroupBox>


        
        <GroupBox Header="Generowanie hasła"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="5">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Ile znaków?"
                       Grid.Row="0"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="txtLiczbaZnakow"
                         Grid.Row="0"
                         Margin="100,5,5,5"/>

                <CheckBox x:Name="chkLitery"
                          Content="Małe i wielkie litery"
                          Grid.Row="1"
                          IsChecked="True"/>

                <CheckBox x:Name="chkCyfry"
                          Content="Cyfry"
                          Grid.Row="2"/>

                <CheckBox x:Name="chkSpecjalne"
                          Content="Znaki specjalne"
                          Grid.Row="3"/>

                <Button Content="Generuj hasło"
                        Grid.Row="4"
                        Height="40"
                        Width="150"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="GenerujHaslo_Click"/>
            </Grid>
        </GroupBox>


        
        <Button x:Name="btnZatwierdz"
                Content="Zatwierdź"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Width="150"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#00695C"
                Foreground="White"
                Click="Zatwierdz_Click"/>

    </Grid>
</Window>

