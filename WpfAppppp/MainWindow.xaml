<Window x:Class="WpfAppppp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppppp"
        mc:Ignorable="d"
        Title="Rejestracja konta, wykonał: 000000" Height="450" Width="400">
    <StackPanel Background="#FFE3F2FD">
        <Label Content="Utwórz konto" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"/>
        <Label Content="Email:"/>
        <TextBox x:Name="EmailTextBox" TextWrapping="Wrap" Text="" Width="120"/>
        <Label Content="Hasło:"/>
        <PasswordBox x:Name="PasswordBox" Width="120"/>
        <Label  Content="Powtórz hasło:"/>
        <PasswordBox x:Name="RepeatPasswordBox" Width="120"/>
        <Button x:Name="Button" Content="Zatwierdź" Width="120" HorizontalAlignment="Center" Click="Zatwierdz_Click"/>
        <TextBox x:Name="MessageTextBlock" TextWrapping="Wrap" Text="" Width="120"/>


    </StackPanel>
</Window>
